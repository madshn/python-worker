{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(./**)",
      "Edit(./**)",
      "Glob(**)",
      "Grep(**)",
      "Bash",
      "Task(*)",
      "Skill(*)",
      "WebFetch",
      "WebSearch",
      "AskUserQuestion",
      "NotebookEdit(./**)",
      "mcp__*",
      "mcp__associates-tools__*",
      "mcp__plugin_Notion_notion__*",
      "mcp__plugin_context7_context7__*"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)",
      "mcp__claude_ai_*"
    ]
  },
  "extraKnownMarketplaces": {
    "mira-plugins": {
      "source": {
        "source": "directory",
        "path": "~/ops/mira/.claude/plugins"
      }
    }
  },
  "enabledPlugins": {
    "kiosk@mira-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/madsnissen/ops/python-worker/.claude/hooks/repotic-session-start.sh"
          }
        ]
      }
    ]
  }
}